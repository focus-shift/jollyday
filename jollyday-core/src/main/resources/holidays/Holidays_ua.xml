<?xml version="1.0" encoding="UTF-8"?>

<Configuration hierarchy="ua" description="Ukraine"
               xmlns="https://focus_shift.de/jollyday/schema/holiday"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://focus_shift.de/jollyday/schema/holiday https://focus_shift.de/jollyday/schema/holiday/holiday.xsd">
  <Holidays>
    <Fixed month="JANUARY" day="1" descriptionPropertiesKey="NEW_YEAR">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="JANUARY" day="7" descriptionPropertiesKey="CHRISTMAS">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="MARCH" day="8" descriptionPropertiesKey="INTERNATIONAL_WOMAN">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="MAY" day="1" descriptionPropertiesKey="LABOUR_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="MAY" day="2" descriptionPropertiesKey="LABOUR_DAY" validTo="2017">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="MAY" day="3" descriptionPropertiesKey="LABOUR_DAY" validFrom="2016" validTo="2016"/>
    <Fixed month="MAY" day="9" descriptionPropertiesKey="VICTORY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="JUNE" day="28" descriptionPropertiesKey="CONSTITUTION_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="AUGUST" day="24" descriptionPropertiesKey="INDEPENDENCE_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="OCTOBER" day="14" descriptionPropertiesKey="DEFENDER_OF_UKRAINE" validFrom="2015">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="DECEMBER" day="25" descriptionPropertiesKey="CHRISTMAS" validFrom="2017">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <ChristianHoliday type="EASTER" chronology="JULIAN">
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </ChristianHoliday>
    <ChristianHoliday type="PENTECOST" chronology="JULIAN">
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </ChristianHoliday>
  </Holidays>

  <Sources>
    <Source>https://en.wikipedia.org/wiki/Public_holidays_in_Ukraine</Source>
    <Source of="ISO 3166">https://www.iso.org/obp/ui/#iso:code:3166:UA</Source>
    <Source of="ISO 3166-2">https://en.wikipedia.org/wiki/ISO_3166-2:UA</Source>
    <Source of="Кодекс законів про працю України, Стаття 73">https://zakon.rada.gov.ua/laws/show/322-08</Source>
    <Source of="Law 3258-IX of 14.07.2023 amending Article 73">https://zakon.rada.gov.ua/laws/show/3258-20</Source>
  </Sources>

  <!-- Article 73 delegates nothing to the oblasts, and Article 92(1)(6) of the
       Constitution reserves labour regulation to national law, so local councils cannot
       create work-free days. The non-Orthodox clause of Article 73 gives individual
       believers up to three days off, granted by the employer and worked back, so it is
       neither a public holiday nor territorial. In Ukrainian law Crimea and Sevastopol
       follow the national calendar unchanged. -->

