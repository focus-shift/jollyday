    <Fixed month="JANUARY" day="18" validFrom="2027" descriptionPropertiesKey="BIRTH_OF_RUBEN_DARIO"/>
    <Fixed month="FEBRUARY" day="1" descriptionPropertiesKey="AIR_FORCE_DAY" localizedType="OBSERVANCE"/>
