  <Holidays>
    <!-- Public Holidays Act, s. 3(3), as inserted by Act No. 13 of 2026 (in force 13 August 2026): where a public holiday
         falls on a Sunday, the following day is observed as public holiday. Modelled as a Sunday to Monday move on every
         holiday from its first date on or after 13 August 2026. Not on 1 January and 1 November (All Saints): the
         following day (2 January, 2 November) is a public holiday anyway. -->
    <Fixed month="JANUARY" day="1" descriptionPropertiesKey="NEW_YEAR"/>
    <Fixed month="JANUARY" day="2" validTo="2026" descriptionPropertiesKey="NEW_YEAR"/>
    <Fixed month="JANUARY" day="2" validFrom="2027" descriptionPropertiesKey="NEW_YEAR">
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
