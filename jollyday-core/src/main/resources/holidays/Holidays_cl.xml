<?xml version="1.0" encoding="UTF-8"?>

<Configuration hierarchy="cl" description="Chile"
               xmlns="https://focus_shift.de/jollyday/schema/holiday"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://focus_shift.de/jollyday/schema/holiday https://focus_shift.de/jollyday/schema/holiday/holiday.xsd">
  <Holidays>
    <Fixed month="JANUARY" day="1" descriptionPropertiesKey="NEW_YEAR"/>
    <Fixed month="JANUARY" day="17" validFrom="2010" validTo="2010" descriptionPropertiesKey="ELECTION_DAY"/>
    <Fixed month="MAY" day="1" descriptionPropertiesKey="LABOUR_DAY"/>
    <Fixed month="MAY" day="21" descriptionPropertiesKey="NAVY_DAY"/>
    <Fixed month="JUNE" day="29" validTo="1999" descriptionPropertiesKey="ST_PETER_PAUL"/>
    <!-- Ley 19.668: Tuesday to Thursday moves to the Monday of the same week, Friday to the following Monday -->
    <Fixed month="JUNE" day="29" validFrom="2000" descriptionPropertiesKey="ST_PETER_PAUL">
      <MovingCondition substitute="TUESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="WEDNESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="THURSDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="FRIDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="JULY" day="16" validFrom="2007" descriptionPropertiesKey="VIRGIN_CARMEN"/>
    <Fixed month="AUGUST" day="15" descriptionPropertiesKey="ASSUMPTION_MARY"/>
    <Fixed month="SEPTEMBER" day="18" descriptionPropertiesKey="NATIONAL_DAY"/>
    <Fixed month="SEPTEMBER" day="19" descriptionPropertiesKey="ARMY_DAY"/>
    <Fixed month="OCTOBER" day="12" validTo="1999" descriptionPropertiesKey="COLUMBUS_DAY"/>
    <!-- Ley 19.668: Tuesday to Thursday moves to the Monday of the same week, Friday to the following Monday -->
    <Fixed month="OCTOBER" day="12" validFrom="2000" descriptionPropertiesKey="COLUMBUS_DAY">
      <MovingCondition substitute="TUESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="WEDNESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="THURSDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="FRIDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <!-- Ley 20.299: Tuesday moves to the Friday before, Wednesday to the Friday of the same week -->
    <Fixed month="OCTOBER" day="31" validFrom="2008" descriptionPropertiesKey="REFORMATION_DAY">
      <MovingCondition substitute="TUESDAY" with="PREVIOUS" weekday="FRIDAY"/>
      <MovingCondition substitute="WEDNESDAY" with="NEXT" weekday="FRIDAY"/>
    </Fixed>
    <Fixed month="NOVEMBER" day="1" descriptionPropertiesKey="ALL_SAINTS"/>
    <Fixed month="DECEMBER" day="8" descriptionPropertiesKey="IMMACULATE_CONCEPTION"/>
    <Fixed month="DECEMBER" day="25" descriptionPropertiesKey="CHRISTMAS"/>
    <!-- Ley General de Bancos art. 38: banks are closed, but it is not a public holiday -->
    <Fixed month="DECEMBER" day="31" descriptionPropertiesKey="NEW_YEARS_EVE" localizedType="BANK_HOLIDAY"/>

    <!-- One-off holidays -->
    <!-- Ley 20.450: bicentennial -->
    <Fixed month="SEPTEMBER" day="17" validFrom="2010" validTo="2010" descriptionPropertiesKey="FIESTAS_PATRIAS"/>
    <Fixed month="SEPTEMBER" day="20" validFrom="2010" validTo="2010" descriptionPropertiesKey="FIESTAS_PATRIAS"/>
    <!-- Ley 17.374 art. 43: national census -->
    <Fixed month="APRIL" day="19" validFrom="2017" validTo="2017" descriptionPropertiesKey="NATIONAL_CENSUS_DAY"/>
    <!-- Ley 21.482 -->
    <Fixed month="SEPTEMBER" day="16" validFrom="2022" validTo="2022" descriptionPropertiesKey="FIESTAS_PATRIAS"/>

    <!-- Ley 21.357: day of the southern winter solstice, no calculation in the engine yet, so one entry per year -->
    <Fixed month="JUNE" day="21" validFrom="2021" validTo="2021" descriptionPropertiesKey="INDIGENOUS_PEOPLES_DAY"/>
    <Fixed month="JUNE" day="21" validFrom="2022" validTo="2022" descriptionPropertiesKey="INDIGENOUS_PEOPLES_DAY"/>
    <Fixed month="JUNE" day="21" validFrom="2023" validTo="2023" descriptionPropertiesKey="INDIGENOUS_PEOPLES_DAY"/>
    <Fixed month="JUNE" day="20" validFrom="2024" validTo="2024" descriptionPropertiesKey="INDIGENOUS_PEOPLES_DAY"/>
    <Fixed month="JUNE" day="20" validFrom="2025" validTo="2025" descriptionPropertiesKey="INDIGENOUS_PEOPLES_DAY"/>
    <Fixed month="JUNE" day="21" validFrom="2026" validTo="2026" descriptionPropertiesKey="INDIGENOUS_PEOPLES_DAY"/>

    <ChristianHoliday type="EASTER"/>
    <ChristianHoliday type="GOOD_FRIDAY"/>
    <ChristianHoliday type="EASTER_SATURDAY"/>
    <ChristianHoliday type="CORPUS_CHRISTI" validTo="1999"/>
    <!-- Ley 19.668: moved to the Monday of the same week until Ley 20.148 replaced it with 16 July -->
    <ChristianHoliday type="CORPUS_CHRISTI" validFrom="2000" validTo="2006">
      <MovingCondition substitute="THURSDAY" with="PREVIOUS" weekday="MONDAY"/>
    </ChristianHoliday>

    <!-- Ley 20.983: 2 January if 1 January is a Sunday -->
    <FixedWeekdayBetweenFixed weekday="MONDAY" validFrom="2017" descriptionPropertiesKey="NEW_YEAR">
      <from month="JANUARY" day="2"/>
      <to month="JANUARY" day="2"/>
    </FixedWeekdayBetweenFixed>
    <!-- Código del Trabajo art. 35 ter (Ley 20.215): Monday 17 September if 18/19 September are Tuesday/Wednesday -->
    <FixedWeekdayBetweenFixed weekday="MONDAY" validFrom="2007" descriptionPropertiesKey="FIESTAS_PATRIAS">
      <from month="SEPTEMBER" day="17"/>
      <to month="SEPTEMBER" day="17"/>
    </FixedWeekdayBetweenFixed>
    <!-- Código del Trabajo art. 35 ter (Ley 20.215): Friday 20 September if 18/19 September are Wednesday/Thursday -->
    <FixedWeekdayBetweenFixed weekday="FRIDAY" validFrom="2007" descriptionPropertiesKey="FIESTAS_PATRIAS">
      <from month="SEPTEMBER" day="20"/>
      <to month="SEPTEMBER" day="20"/>
    </FixedWeekdayBetweenFixed>
    <!-- Ley 20.983: Friday 17 September if 18/19 September are Saturday/Sunday -->
    <FixedWeekdayBetweenFixed weekday="FRIDAY" validFrom="2017" descriptionPropertiesKey="FIESTAS_PATRIAS">
      <from month="SEPTEMBER" day="17"/>
      <to month="SEPTEMBER" day="17"/>
    </FixedWeekdayBetweenFixed>
  </Holidays>

