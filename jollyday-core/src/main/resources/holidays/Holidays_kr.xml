               xmlns="https://focus_shift.de/jollyday/schema/holiday"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://focus_shift.de/jollyday/schema/holiday https://focus_shift.de/jollyday/schema/holiday/holiday.xsd">
  <Holidays>
    <!-- New Year's Day - exempt from the substitute holiday rule -->
    <Fixed month="JANUARY" day="1" validFrom="1949" descriptionPropertiesKey="NEW_YEAR"/>
    <!-- 2 and 3 January were also public holidays until 1998 and 1989 respectively -->
    <Fixed month="JANUARY" day="2" validFrom="1949" validTo="1998" descriptionPropertiesKey="NEW_YEAR"/>
    <Fixed month="JANUARY" day="3" validFrom="1949" validTo="1989" descriptionPropertiesKey="NEW_YEAR"/>

    <!-- NOTE on the substitute-holiday (대체공휴일) model: under Korean law a substitute
         day is an ADDITIONAL day off and the statutory date remains a holiday.
         MovingCondition instead relocates a holiday, so isHoliday() on a weekend
         statutory date returns false. For the recurring solar holidays below this is
         accepted as a known limitation, since MovingCondition is the only recurring
         rule available; the per-year lunar block further down avoids the problem by
         listing both the statutory and the substitute dates explicitly. -->

    <!-- Independence Movement Day - substitute holiday rule applies since August 2021 -->
    <Fixed month="MARCH" day="1" validFrom="1949" validTo="2020" descriptionPropertiesKey="INDEPENDENCE_MOVEMENT_DAY"/>
    <Fixed month="MARCH" day="1" validFrom="2021" descriptionPropertiesKey="INDEPENDENCE_MOVEMENT_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <!-- Arbor Day - was a public holiday until 2005 -->
    <Fixed month="APRIL" day="5" validFrom="1949" validTo="2005" descriptionPropertiesKey="ARBOR"/>

    <!-- Labour Day (근로자의 날) - since 1994 a statutory paid day off for private-sector
         employees under the Labor Standards Act (government offices open, banks closed);
         a public holiday with substitute rule since the 2026 Public Holidays Act amendment -->
    <Fixed month="MAY" day="1" validFrom="1994" validTo="2025" descriptionPropertiesKey="LABOUR_DAY"
           localizedType="BANK_HOLIDAY"/>
    <Fixed month="MAY" day="1" validFrom="2026" descriptionPropertiesKey="LABOUR_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <!-- Children's Day - public holiday since 1975, substitute holiday rule applies since 2014 -->
    <Fixed month="MAY" day="5" validFrom="1975" validTo="2013" descriptionPropertiesKey="CHILDRENS_DAY"/>
    <Fixed month="MAY" day="5" validFrom="2014" descriptionPropertiesKey="CHILDRENS_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <!-- Memorial Day - exempt from the substitute holiday rule -->
    <Fixed month="JUNE" day="6" validFrom="1956" descriptionPropertiesKey="MEMORIAL_DAY"/>

    <!-- Constitution Day - public holiday 1949 until 2007, reinstated with substitute rule
