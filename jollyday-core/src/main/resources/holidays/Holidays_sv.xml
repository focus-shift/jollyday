  <SubConfigurations hierarchy="li" description="La Libertad">
    <Holidays/>
  </SubConfigurations>

  <SubConfigurations hierarchy="mo" description="Morazán">
    <Holidays/>
  </SubConfigurations>

  <SubConfigurations hierarchy="pa" description="La Paz">
    <Holidays/>
  </SubConfigurations>

  <SubConfigurations hierarchy="sa" description="Santa Ana">
    <Holidays/>
  </SubConfigurations>

  <SubConfigurations hierarchy="sm" description="San Miguel">
    <Holidays/>
  </SubConfigurations>

  <SubConfigurations hierarchy="so" description="Sonsonate">
    <Holidays/>
  </SubConfigurations>

  <SubConfigurations hierarchy="ss" description="San Salvador">
    <Holidays>
      <!-- Art. 190 grants 3 and 5 August in the city of San Salvador only -->
      <Fixed day="3" month="AUGUST" descriptionPropertiesKey="AUGUST_FESTIVALS"/>
      <Fixed day="5" month="AUGUST" descriptionPropertiesKey="AUGUST_FESTIVALS"/>
    </Holidays>
  </SubConfigurations>

  <SubConfigurations hierarchy="sv" description="San Vicente">
