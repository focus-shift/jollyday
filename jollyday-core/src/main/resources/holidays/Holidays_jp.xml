               xsi:schemaLocation="https://focus_shift.de/jollyday/schema/holiday https://focus_shift.de/jollyday/schema/holiday/holiday.xsd">
  <!--
    Substitute holidays (Art. 3(2) of the Act on National Holidays):
    From 12 April 1973 until 2006 a national holiday falling on a Sunday was followed by a holiday on the Monday.
    This is modelled per holiday with a Sunday to Monday MovingCondition for 1973 (1974 for holidays before 12 April) to 2006.
    Since 2007 the substitute is the next day that is not a national holiday; this is only modelled for Culture Day so far.
    Citizens' holidays (Art. 3(3)) are calculated by the JapaneseBridgingHolidayManager.
    Vernal and Autumnal Equinox Day are not modelled yet.
  -->
  <Holidays>
    <Fixed month="JANUARY" day="1" validFrom="1948" validTo="1973" descriptionPropertiesKey="NEW_YEAR"/>
    <Fixed month="JANUARY" day="1" validFrom="1974" validTo="2006" descriptionPropertiesKey="NEW_YEAR">
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="JANUARY" day="1" validFrom="2007" descriptionPropertiesKey="NEW_YEAR"/>
    <Fixed month="JANUARY" day="15" validFrom="1948" validTo="1973" descriptionPropertiesKey="COMING_OF_AGE"/>
