<?xml version="1.0" encoding="UTF-8"?>

<Configuration hierarchy="ms" description="Montserrat"
               xmlns="https://focus_shift.de/jollyday/schema/holiday"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://focus_shift.de/jollyday/schema/holiday https://focus_shift.de/jollyday/schema/holiday/holiday.xsd">
  <Holidays>
    <!-- If a public holiday falls on a Saturday or Sunday, the next following Monday is a public holiday.
         Where two consecutive holidays fall on a weekend, the following Monday and Tuesday are observed.
         (Public Holidays Act, Cap. 6.09 (Act 13 of 2024), Schedule paragraphs 2-5) -->
    <Fixed month="JANUARY" day="1" descriptionPropertiesKey="NEW_YEAR">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="TUESDAY"/>
      <MovingCondition substitute="MONDAY" with="NEXT" weekday="TUESDAY"/>
    </Fixed>
    <Fixed month="MARCH" day="17" descriptionPropertiesKey="ST_PATRICK">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="DECEMBER" day="25" descriptionPropertiesKey="CHRISTMAS">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="DECEMBER" day="26" descriptionPropertiesKey="BOXING_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="TUESDAY"/>
      <MovingCondition substitute="MONDAY" with="NEXT" weekday="TUESDAY"/>
    </Fixed>
    <Fixed month="DECEMBER" day="31" descriptionPropertiesKey="FESTIVAL_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <!-- Sovereign's birthday: the Schedule has no date, the Governor appoints the day by proclamation
         each year (s. 4). S.R.O. 18 of 2024, S.R.O. 3 of 2025, S.R.O. 22 of 2026. -->
    <Fixed month="JUNE" day="17" validFrom="2024" validTo="2024" descriptionPropertiesKey="KINGS_BIRTHDAY"/>
    <Fixed month="JUNE" day="16" validFrom="2025" validTo="2025" descriptionPropertiesKey="KINGS_BIRTHDAY"/>
    <Fixed month="JUNE" day="13" validFrom="2026" validTo="2026" descriptionPropertiesKey="KINGS_BIRTHDAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <!-- National Day of Prayer and Thanksgiving: declared each year until 2022,
         second Wednesday in July since S.R.O. 15 of 2023. -->
    <Fixed month="JULY" day="21" validFrom="2021" validTo="2021" descriptionPropertiesKey="NATIONAL_DAY_OF_PRAYER_AND_THANKSGIVING"/>
    <Fixed month="JULY" day="20" validFrom="2022" validTo="2022" descriptionPropertiesKey="NATIONAL_DAY_OF_PRAYER_AND_THANKSGIVING"/>

    <FixedWeekday which="FIRST" weekday="MONDAY" month="MAY" descriptionPropertiesKey="LABOUR_DAY"/>
    <FixedWeekday which="SECOND" weekday="MONDAY" month="JUNE" validTo="2022" descriptionPropertiesKey="QUEENS_BIRTHDAY"/>
    <FixedWeekday which="SECOND" weekday="MONDAY" month="JUNE" validFrom="2023" validTo="2023" descriptionPropertiesKey="KINGS_BIRTHDAY"/>
    <FixedWeekday which="SECOND" weekday="WEDNESDAY" month="JULY" validFrom="2023" descriptionPropertiesKey="NATIONAL_DAY_OF_PRAYER_AND_THANKSGIVING"/>
    <FixedWeekday which="FIRST" weekday="MONDAY" month="AUGUST" descriptionPropertiesKey="EMANCIPATION_DAY"/>

    <ChristianHoliday type="GOOD_FRIDAY"/>
    <ChristianHoliday type="EASTER_MONDAY"/>
    <ChristianHoliday type="WHIT_MONDAY"/>
  </Holidays>

