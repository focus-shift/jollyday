<?xml version="1.0" encoding="UTF-8"?>

<Configuration hierarchy="ga" description="Gabon"
               xmlns="https://focus_shift.de/jollyday/schema/holiday"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://focus_shift.de/jollyday/schema/holiday https://focus_shift.de/jollyday/schema/holiday/holiday.xsd">
  <Holidays>
    <Fixed month="JANUARY" day="1" descriptionPropertiesKey="NEW_YEAR"/>
    <Fixed month="APRIL" day="17" descriptionPropertiesKey="WOMENS_DAY"/>
    <Fixed month="MAY" day="1" descriptionPropertiesKey="LABOUR_DAY"/>
    <Fixed month="AUGUST" day="15" descriptionPropertiesKey="ASSUMPTION_MARY"/>
    <Fixed month="AUGUST" day="16" descriptionPropertiesKey="INDEPENDENCE_DAY"/>
    <Fixed month="AUGUST" day="17" descriptionPropertiesKey="INDEPENDENCE_DAY"/>
    <!-- Journée nationale de la Libération, first celebrated 30 August 2024; Constitution of 19 December 2024, art. 2 -->
    <Fixed month="AUGUST" day="30" validFrom="2024" descriptionPropertiesKey="LIBERATION"/>
    <Fixed month="NOVEMBER" day="1" descriptionPropertiesKey="ALL_SAINTS"/>
    <Fixed month="DECEMBER" day="25" descriptionPropertiesKey="CHRISTMAS"/>
    <ChristianHoliday type="EASTER_MONDAY"/>
    <ChristianHoliday type="ASCENSION_DAY"/>
    <ChristianHoliday type="WHIT_MONDAY"/>
    <IslamicHoliday type="ID_AL_FITR"/>
    <IslamicHoliday type="ID_UL_ADHA"/>
  </Holidays>

  <Sources>
    <Source>https://en.wikipedia.org/wiki/Public_holidays_in_Gabon</Source>
    <Source of="Constitution of 19 December 2024, art. 2 (Journal Officiel n°47 Bis)">https://gabonmediatime.com/wp-content/uploads/2024/12/Journal-Officiel_n%C2%B047-Bis-du-19-decembre-2024_Constitution.pdf</Source>
    <Source of="Communiqué final du Conseil des Ministres du 31 août 2024">https://directinfosgabon.com/wp-content/uploads/2024/09/Communique-Final-du-Conseil-des-Ministres-du-31-ao_240901_003018.pdf</Source>
    <Source of="ISO 3166-2">https://en.wikipedia.org/wiki/ISO_3166-2:GA</Source>
    <Source of="ISO 3166">https://www.iso.org/obp/ui/#iso:code:3166:GA</Source>
  </Sources>

