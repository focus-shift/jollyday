    <Fixed month="JULY" day="10" validFrom="2020" validTo="2020" descriptionPropertiesKey="TOURIST_HOLIDAY"/>
    <Fixed month="DECEMBER" day="7" validFrom="2020" validTo="2020" descriptionPropertiesKey="TOURIST_HOLIDAY"/>
    <!-- 2021: Decree 947/2020 (feriados) -->
    <Fixed month="MAY" day="24" validFrom="2021" validTo="2021" descriptionPropertiesKey="TOURIST_HOLIDAY"/>
    <Fixed month="OCTOBER" day="8" validFrom="2021" validTo="2021" descriptionPropertiesKey="TOURIST_HOLIDAY"/>
    <Fixed month="NOVEMBER" day="22" validFrom="2021" validTo="2021" descriptionPropertiesKey="TOURIST_HOLIDAY"/>
    <!-- 2022: Decree 789/2021 (feriados) -->
    <Fixed month="OCTOBER" day="7" validFrom="2022" validTo="2022" descriptionPropertiesKey="TOURIST_HOLIDAY"/>
    <Fixed month="NOVEMBER" day="21" validFrom="2022" validTo="2022" descriptionPropertiesKey="TOURIST_HOLIDAY"/>
    <Fixed month="DECEMBER" day="9" validFrom="2022" validTo="2022" descriptionPropertiesKey="TOURIST_HOLIDAY"/>
    <!-- 2023: Decree 764/2022 (feriados) -->
    <Fixed month="MAY" day="26" validFrom="2023" validTo="2023" descriptionPropertiesKey="TOURIST_HOLIDAY"/>
    <Fixed month="JUNE" day="19" validFrom="2023" validTo="2023" descriptionPropertiesKey="TOURIST_HOLIDAY"/>
    <Fixed month="OCTOBER" day="13" validFrom="2023" validTo="2023" descriptionPropertiesKey="TOURIST_HOLIDAY"/>
    <!-- 2024: Decree 106/2023 (feriados) -->
    <Fixed month="APRIL" day="1" validFrom="2024" validTo="2024" descriptionPropertiesKey="TOURIST_HOLIDAY"/>
    <Fixed month="JUNE" day="21" validFrom="2024" validTo="2024" descriptionPropertiesKey="TOURIST_HOLIDAY"/>
    <Fixed month="OCTOBER" day="11" validFrom="2024" validTo="2024" descriptionPropertiesKey="TOURIST_HOLIDAY"/>
    <!-- 2025: Decree 1027/2024 (días no laborables) -->
    <Fixed month="MAY" day="2" validFrom="2025" validTo="2025" descriptionPropertiesKey="TOURIST_HOLIDAY" localizedType="OBSERVANCE"/>
    <Fixed month="AUGUST" day="15" validFrom="2025" validTo="2025" descriptionPropertiesKey="TOURIST_HOLIDAY" localizedType="OBSERVANCE"/>
    <Fixed month="NOVEMBER" day="21" validFrom="2025" validTo="2025" descriptionPropertiesKey="TOURIST_HOLIDAY" localizedType="OBSERVANCE"/>
    <!-- 2026: Resolution JGM 164/2025 (días no laborables) -->
    <Fixed month="MARCH" day="23" validFrom="2026" validTo="2026" descriptionPropertiesKey="TOURIST_HOLIDAY" localizedType="OBSERVANCE"/>
    <Fixed month="JULY" day="10" validFrom="2026" validTo="2026" descriptionPropertiesKey="TOURIST_HOLIDAY" localizedType="OBSERVANCE"/>
    <Fixed month="DECEMBER" day="7" validFrom="2026" validTo="2026" descriptionPropertiesKey="TOURIST_HOLIDAY" localizedType="OBSERVANCE"/>

    <!-- One-off feriados: national census (Decree 42/2022), World Cup victory (DNU 842/2022) -->
    <Fixed month="MAY" day="18" validFrom="2022" validTo="2022" descriptionPropertiesKey="NATIONAL_CENSUS_DAY"/>
    <Fixed month="DECEMBER" day="20" validFrom="2022" validTo="2022" descriptionPropertiesKey="WORLD_CUP_VICTORY_CELEBRATION"/>

    <FixedWeekday which="THIRD" weekday="MONDAY" month="JUNE" validFrom="1995" validTo="2010" descriptionPropertiesKey="FLAG_DAY"/>
    <FixedWeekday which="THIRD" weekday="MONDAY" month="AUGUST" validFrom="1995" validTo="2010" descriptionPropertiesKey="MARTIN_DAY"/>
    <FixedWeekday which="THIRD" weekday="MONDAY" month="AUGUST" validFrom="2012" validTo="2016" descriptionPropertiesKey="MARTIN_DAY"/>
    <FixedWeekday which="SECOND" weekday="MONDAY" month="OCTOBER" validFrom="2011" validTo="2016" descriptionPropertiesKey="COLUMBUS_DAY"/>
    <FixedWeekday which="FOURTH" weekday="MONDAY" month="NOVEMBER" validFrom="2010" validTo="2014" descriptionPropertiesKey="NATIONAL_SOVEREIGNTY_DAY"/>
    <FixedWeekday which="FOURTH" weekday="MONDAY" month="NOVEMBER" validFrom="2016" validTo="2016" descriptionPropertiesKey="NATIONAL_SOVEREIGNTY_DAY"/>

    <ChristianHoliday type="CLEAN_MONDAY"/>
    <ChristianHoliday type="CARNIVAL"/>
    <!-- Jueves Santo is a día no laborable (Law 27.399 art. 1) -->
    <ChristianHoliday type="MAUNDY_THURSDAY" localizedType="OBSERVANCE"/>
    <ChristianHoliday type="GOOD_FRIDAY"/>
