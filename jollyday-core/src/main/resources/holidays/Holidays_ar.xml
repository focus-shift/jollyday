<?xml version="1.0" encoding="UTF-8"?>

<Configuration hierarchy="ar" description="Argentina"
               xmlns="https://focus_shift.de/jollyday/schema/holiday"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://focus_shift.de/jollyday/schema/holiday https://focus_shift.de/jollyday/schema/holiday/holiday.xsd">
  <Holidays>
    <Fixed month="JANUARY" day="1" descriptionPropertiesKey="NEW_YEAR"/>
    <Fixed month="MARCH" day="24" validFrom="2006" descriptionPropertiesKey="REMEMBRANCE_TRUTH_JUSTICE"/>
    <Fixed month="APRIL" day="2" validFrom="2001" descriptionPropertiesKey="MALVINAS"/>
    <Fixed month="MAY" day="1" descriptionPropertiesKey="LABOUR_DAY"/>
    <Fixed month="MAY" day="25" descriptionPropertiesKey="MAY_REVOLUTION"/>

    <!--
      17 June: Paso a la Inmortalidad del General Martín Miguel de Güemes, a feriado since Law 27.258 (June 2016).
      2016: not movable under Decree 1584/2010. Since 2017 movable (Decree 52/2017, Law 27.399 art. 6):
      Tuesday/Wednesday to the previous Monday, Thursday to the next Monday. A Friday would move onto
      20 June, so it stays (Decree 789/2021; no Friday occurred in 2017-2021). Weekends stay.
    -->
    <Fixed month="JUNE" day="17" validFrom="2016" validTo="2016" descriptionPropertiesKey="GUEMES_DAY"/>
    <Fixed month="JUNE" day="17" validFrom="2017" descriptionPropertiesKey="GUEMES_DAY">
      <MovingCondition substitute="TUESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="WEDNESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="THURSDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <!--
      20 June: Paso a la Inmortalidad del General Manuel Belgrano (Flag Day). On its date under Law 21.329 and
      as an exception of Law 23.555 until 1994, on the third Monday of June 1995-2010 (Law 24.445, see
      FixedWeekday below), not movable since 2011 (Decree 1584/2010, Decree 80/2017, Law 27.399).
    -->
    <Fixed month="JUNE" day="20" validTo="1994" descriptionPropertiesKey="FLAG_DAY"/>
    <Fixed month="JUNE" day="20" validFrom="2011" descriptionPropertiesKey="FLAG_DAY"/>

    <Fixed month="JULY" day="9" descriptionPropertiesKey="INDEPENDENCE_DAY"/>

    <!--
      17 August: Paso a la Inmortalidad del General José de San Martín. On its date until 1991 (exception of
      Law 23.555), movable 1992-1994 (Law 24.023 removed the exception, Law 24.360 restored it after
      17 August 1994), third Monday of August 1995-2016 (Law 24.445, Decree 1584/2010, see FixedWeekday below;
      2011 moved to 22 August by Decree 521/2011), movable per Law 27.399 art. 6 since 2017. Weekends stay.
    -->
    <Fixed month="AUGUST" day="17" validTo="1991" descriptionPropertiesKey="MARTIN_DAY"/>
    <Fixed month="AUGUST" day="17" validFrom="1992" validTo="1994" descriptionPropertiesKey="MARTIN_DAY">
      <MovingCondition substitute="TUESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="WEDNESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="THURSDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="FRIDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="AUGUST" day="22" validFrom="2011" validTo="2011" descriptionPropertiesKey="MARTIN_DAY"/>
    <Fixed month="AUGUST" day="17" validFrom="2017" descriptionPropertiesKey="MARTIN_DAY">
      <MovingCondition substitute="TUESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="WEDNESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="THURSDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="FRIDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <!--
      12 October: Día del Respeto a la Diversidad Cultural. On its date until 1987. Movable per Law 23.555 from 1988
      (Tuesday/Wednesday to the previous Monday, Thursday/Friday to the next Monday), except the one-off moves
      of 2001 (Law 25.442), 2002 (Decree 1932/2002) and 2003 (Decree 810/2003). Saturday/Sunday also moved to the
      next Monday 2008-2010 (Law 26.416). Second Monday of October 2011-2016 (Decree 1584/2010, see FixedWeekday
      below). Movable per Law 27.399 art. 6 since 2017, weekends stay; 2025 moved to Friday 10 October by
      Resolution JGM 139/2025 (Decree 614/2025).
    -->
    <Fixed month="OCTOBER" day="12" validTo="1987" descriptionPropertiesKey="COLUMBUS_DAY"/>
    <Fixed month="OCTOBER" day="12" validFrom="1988" validTo="2000" descriptionPropertiesKey="COLUMBUS_DAY">
      <MovingCondition substitute="TUESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="WEDNESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="THURSDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="FRIDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="OCTOBER" day="8" validFrom="2001" validTo="2001" descriptionPropertiesKey="COLUMBUS_DAY"/>
    <Fixed month="OCTOBER" day="14" validFrom="2002" validTo="2002" descriptionPropertiesKey="COLUMBUS_DAY"/>
    <Fixed month="OCTOBER" day="13" validFrom="2003" validTo="2003" descriptionPropertiesKey="COLUMBUS_DAY"/>
    <Fixed month="OCTOBER" day="12" validFrom="2004" validTo="2007" descriptionPropertiesKey="COLUMBUS_DAY">
      <MovingCondition substitute="TUESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="WEDNESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="THURSDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="FRIDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="OCTOBER" day="12" validFrom="2008" validTo="2010" descriptionPropertiesKey="COLUMBUS_DAY">
      <MovingCondition substitute="TUESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="WEDNESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="THURSDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="FRIDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="OCTOBER" day="12" validFrom="2017" validTo="2024" descriptionPropertiesKey="COLUMBUS_DAY">
      <MovingCondition substitute="TUESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="WEDNESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="THURSDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="FRIDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="OCTOBER" day="10" validFrom="2025" validTo="2025" descriptionPropertiesKey="COLUMBUS_DAY"/>
    <Fixed month="OCTOBER" day="12" validFrom="2026" descriptionPropertiesKey="COLUMBUS_DAY">
      <MovingCondition substitute="TUESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="WEDNESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="THURSDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="FRIDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <Fixed month="OCTOBER" day="27" validFrom="2010" validTo="2010"
           descriptionPropertiesKey="NATIONAL_DAY_OF_MOURNING_KIRCHNER" localizedType="OBSERVANCE"/>

    <!--
      20 November: Día de la Soberanía Nacional, a feriado since Decree 1584/2010. Fourth Monday of November
      2010-2016 (see FixedWeekday below; 2015 moved to 27 November by Decree 2226/2015), movable per
      Law 27.399 art. 6 since 2017. Weekends stay.
    -->
    <Fixed month="NOVEMBER" day="27" validFrom="2015" validTo="2015" descriptionPropertiesKey="NATIONAL_SOVEREIGNTY_DAY"/>
    <Fixed month="NOVEMBER" day="20" validFrom="2017" descriptionPropertiesKey="NATIONAL_SOVEREIGNTY_DAY">
      <MovingCondition substitute="TUESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="WEDNESDAY" with="PREVIOUS" weekday="MONDAY"/>
      <MovingCondition substitute="THURSDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="FRIDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <Fixed month="DECEMBER" day="8" descriptionPropertiesKey="IMMACULATE_CONCEPTION"/>
    <Fixed month="DECEMBER" day="25" descriptionPropertiesKey="CHRISTMAS"/>

    <!-- Tourist days (Law 27.399 art. 7): días no laborables (OBSERVANCE) or feriados, as set by the decree of each year -->
    <!-- 2018 and 2019: Decree 923/2017 (días no laborables) -->
    <Fixed month="APRIL" day="30" validFrom="2018" validTo="2018" descriptionPropertiesKey="TOURIST_HOLIDAY" localizedType="OBSERVANCE"/>
    <Fixed month="DECEMBER" day="24" validFrom="2018" validTo="2018" descriptionPropertiesKey="TOURIST_HOLIDAY" localizedType="OBSERVANCE"/>
    <Fixed month="DECEMBER" day="31" validFrom="2018" validTo="2018" descriptionPropertiesKey="TOURIST_HOLIDAY" localizedType="OBSERVANCE"/>
