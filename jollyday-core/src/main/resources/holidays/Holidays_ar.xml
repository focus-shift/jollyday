    <Fixed month="OCTOBER" day="14" validFrom="2019" validTo="2019" descriptionPropertiesKey="TOURIST_HOLIDAY" localizedType="OBSERVANCE"/>
    <!-- 2020: Decree 717/2019 (feriados) -->
