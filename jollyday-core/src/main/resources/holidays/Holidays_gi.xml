<?xml version="1.0" encoding="UTF-8"?>

<Configuration hierarchy="gi" description="Gibraltar"
               xmlns="https://focus_shift.de/jollyday/schema/holiday"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://focus_shift.de/jollyday/schema/holiday https://focus_shift.de/jollyday/schema/holiday/holiday.xsd">

  <Holidays>
    <Fixed month="JANUARY" day="1" validFrom="1974" descriptionPropertiesKey="NEW_YEAR">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <Fixed month="FEBRUARY" day="15" validFrom="2021" validTo="2021" descriptionPropertiesKey="COMMONWEALTH_DAY"/>
    <Fixed month="MAY" day="24" validFrom="1958" validTo="1976" descriptionPropertiesKey="COMMONWEALTH_DAY"/>

    <Fixed month="APRIL" day="28" validFrom="2018" descriptionPropertiesKey="MEMORIAL_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="MAY" day="1" descriptionPropertiesKey="MAY_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="MAY" day="8" validFrom="2020" validTo="2020" descriptionPropertiesKey="VICTORY_DAY"/>
    <Fixed month="MAY" day="8" validFrom="2023" validTo="2023" descriptionPropertiesKey="KINGS_CORONATION"/>

    <Fixed month="JUNE" day="2" validFrom="2022" validTo="2022" descriptionPropertiesKey="SPRING_BANK_HOLIDAY"/>
    <Fixed month="JUNE" day="3" validFrom="2022" validTo="2022" descriptionPropertiesKey="QUEENS_PLATINUM_JUBILEE"/>

    <Fixed month="SEPTEMBER" day="10" validFrom="1967" descriptionPropertiesKey="NATIONAL_DAY_OF_GIBRALTAR">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <Fixed month="DECEMBER" day="25" descriptionPropertiesKey="CHRISTMAS">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="TUESDAY"/>
    </Fixed>

    <Fixed month="DECEMBER" day="26" descriptionPropertiesKey="BOXING_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="TUESDAY"/>
    </Fixed>

    <FixedWeekday which="THIRD" weekday="MONDAY" month="FEBRUARY" validFrom="2022" validTo="2023" descriptionPropertiesKey="WINTER_MIDTERM_BANK_HOLIDAY"/>
    <FixedWeekday which="SECOND" weekday="MONDAY" month="FEBRUARY" validFrom="2024" validTo="2024" descriptionPropertiesKey="WINTER_MIDTERM_BANK_HOLIDAY"/>
    <FixedWeekday which="THIRD" weekday="MONDAY" month="FEBRUARY" validFrom="2025" descriptionPropertiesKey="WINTER_MIDTERM_BANK_HOLIDAY"/>
    <!-- 2022 the Spring Bank Holiday was moved to 2 June for the Platinum Jubilee -->
    <FixedWeekday which="LAST" weekday="MONDAY" month="MAY" validFrom="1971" validTo="2021" descriptionPropertiesKey="SPRING_BANK_HOLIDAY"/>
    <FixedWeekday which="LAST" weekday="MONDAY" month="MAY" validFrom="2023" descriptionPropertiesKey="SPRING_BANK_HOLIDAY"/>
    <FixedWeekday which="LAST" weekday="MONDAY" month="AUGUST" validFrom="1971" descriptionPropertiesKey="SUMMER_BANK_HOLIDAY"/>

    <FixedWeekday which="SECOND" weekday="MONDAY" month="MARCH" validFrom="1977" validTo="2020" descriptionPropertiesKey="COMMONWEALTH_DAY"/>
    <!-- the Monday of the Queen's/King's Birthday is set every year; years before 2018 are not checked yet -->
    <FixedWeekday which="SECOND" weekday="MONDAY" month="JUNE" validFrom="2018" validTo="2018" descriptionPropertiesKey="QUEENS_BIRTHDAY"/>
    <FixedWeekday which="THIRD" weekday="MONDAY" month="JUNE" validFrom="2019" validTo="2020" descriptionPropertiesKey="QUEENS_BIRTHDAY"/>
    <FixedWeekday which="SECOND" weekday="MONDAY" month="JUNE" validFrom="2021" validTo="2022" descriptionPropertiesKey="QUEENS_BIRTHDAY"/>
    <FixedWeekday which="THIRD" weekday="MONDAY" month="JUNE" validFrom="2023" descriptionPropertiesKey="KINGS_BIRTHDAY"/>

    <ChristianHoliday type="GOOD_FRIDAY"/>
    <ChristianHoliday type="EASTER_MONDAY"/>
  </Holidays>

