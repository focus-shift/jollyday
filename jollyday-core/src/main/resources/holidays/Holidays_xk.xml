<?xml version="1.0" encoding="UTF-8"?>

<Configuration hierarchy="xk" description="Kosovo"
               xmlns="https://focus_shift.de/jollyday/schema/holiday"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://focus_shift.de/jollyday/schema/holiday https://focus_shift.de/jollyday/schema/holiday/holiday.xsd">
  <Holidays>
    <!--
      Official holidays (Law No. 03/L-064, Art. 2). If one falls on a Saturday or Sunday,
      the next working day is a day off (Art. 4).
    -->
    <Fixed month="JANUARY" day="1" descriptionPropertiesKey="NEW_YEAR">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="JANUARY" day="2" descriptionPropertiesKey="NEW_YEAR">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="TUESDAY"/>
      <MovingCondition substitute="MONDAY" with="NEXT" weekday="TUESDAY"/>
    </Fixed>
    <Fixed month="JANUARY" day="7" descriptionPropertiesKey="ORTHODOX_CHRISTMAS">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <Fixed month="FEBRUARY" day="17" descriptionPropertiesKey="DECLARATION_OF_INDEPENDENCE_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <!-- Law No. 03/L-064 entered into force on its publication in the Official Gazette on 15 June 2008 -->
    <Fixed month="APRIL" day="9" validFrom="2009" validTo="2022" descriptionPropertiesKey="CONSTITUTION_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <!--
      2023: Sunday 9 April was followed by Catholic Easter Monday, so the Ministry gave 10 and 11 April.
      A substitute on the next day that is not a holiday is not supported yet, see #1511.
    -->
    <Fixed month="APRIL" day="9" validFrom="2023" validTo="2023" descriptionPropertiesKey="CONSTITUTION_DAY">
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="TUESDAY"/>
    </Fixed>
    <Fixed month="APRIL" day="9" validFrom="2024" descriptionPropertiesKey="CONSTITUTION_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <Fixed month="MAY" day="1" descriptionPropertiesKey="LABOUR_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>
    <Fixed month="MAY" day="9" descriptionPropertiesKey="EUROPE_DAY">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <Fixed month="DECEMBER" day="25" descriptionPropertiesKey="CHRISTMAS">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </Fixed>

    <!-- Memorial days (Law No. 03/L-064, Art. 5.5) are working days -->
    <Fixed month="FEBRUARY" day="15" localizedType="OBSERVANCE" descriptionPropertiesKey="DAY_OF_ASHKALI"/>
    <Fixed month="MARCH" day="6" localizedType="OBSERVANCE" descriptionPropertiesKey="VETERANS_DAY"/>
    <Fixed month="APRIL" day="8" localizedType="OBSERVANCE" descriptionPropertiesKey="ROMA_DAY"/>
    <Fixed month="APRIL" day="23" localizedType="OBSERVANCE" descriptionPropertiesKey="DAY_OF_THE_TURKS"/>
    <Fixed month="MAY" day="6" localizedType="OBSERVANCE" descriptionPropertiesKey="DAY_OF_THE_GORANS"/>
    <Fixed month="JUNE" day="12" localizedType="OBSERVANCE" descriptionPropertiesKey="DAY_OF_PEACE"/>
    <Fixed month="SEPTEMBER" day="28" localizedType="OBSERVANCE" descriptionPropertiesKey="DAY_OF_BOSNIAKS"/>
    <Fixed month="NOVEMBER" day="28" localizedType="OBSERVANCE" descriptionPropertiesKey="DAY_OF_ALBANIANS"/>

    <ChristianHoliday type="EASTER_MONDAY"/>
    <ChristianHoliday type="EASTER_MONDAY" chronology="JULIAN" descriptionPropertiesKey="ORTHODOX_EASTER_MONDAY"/>

    <!-- Bajrami i Madh (Fitër Bajram), first day -->
    <IslamicHoliday type="ID_AL_FITR">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </IslamicHoliday>
    <!-- Bajrami i Vogël (Kurban Bajram), first day -->
    <IslamicHoliday type="ID_UL_ADHA">
      <MovingCondition substitute="SATURDAY" with="NEXT" weekday="MONDAY"/>
      <MovingCondition substitute="SUNDAY" with="NEXT" weekday="MONDAY"/>
    </IslamicHoliday>
  </Holidays>

