<?xml version="1.0" encoding="UTF-8"?>

<Configuration hierarchy="hu" description="Hungary"
               xmlns="https://focus_shift.de/jollyday/schema/holiday"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://focus_shift.de/jollyday/schema/holiday https://focus_shift.de/jollyday/schema/holiday/holiday.xsd">
  <Holidays>
    <Fixed month="JANUARY" day="1" descriptionPropertiesKey="NEW_YEAR"/>
    <Fixed month="MARCH" day="15" descriptionPropertiesKey="NATIONAL_DAY"/>
    <Fixed month="MAY" day="1" descriptionPropertiesKey="LABOUR_DAY"/>
    <Fixed month="AUGUST" day="20" descriptionPropertiesKey="STEPHENS"/>
    <Fixed month="OCTOBER" day="23" descriptionPropertiesKey="NATIONAL_DAY"/>
    <Fixed month="NOVEMBER" day="1" descriptionPropertiesKey="ALL_SAINTS"/>
    <Fixed month="DECEMBER" day="24" descriptionPropertiesKey="CHRISTMAS_EVE"/>
    <Fixed month="DECEMBER" day="25" descriptionPropertiesKey="CHRISTMAS"/>
    <Fixed month="DECEMBER" day="26" descriptionPropertiesKey="STEPHENS"/>
    <ChristianHoliday type="EASTER"/>
    <ChristianHoliday type="GOOD_FRIDAY" validFrom="2017"/>
    <ChristianHoliday type="EASTER_MONDAY"/>
    <ChristianHoliday type="WHIT_MONDAY"/>
  </Holidays>

  <Sources>
    <Source>https://en.wikipedia.org/wiki/Public_holidays_in_Hungary</Source>
    <Source of="ISO 3166">https://www.iso.org/obp/ui/#iso:code:3166:HU</Source>
    <Source of="ISO 3166-2">https://en.wikipedia.org/wiki/ISO_3166-2:HU</Source>
    <Source of="2012. évi I. törvény a munka törvénykönyvéről, § 102">https://net.jogtar.hu/jogszabaly?docid=a1200001.tv</Source>
  </Sources>

  <!-- The list in section 102 of the 2012 Labour Code is exhaustive and nationwide.
