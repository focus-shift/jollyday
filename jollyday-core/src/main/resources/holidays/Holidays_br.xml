    <SubConfigurations hierarchy="crj" description="City of Rio de Janeiro">
      <Holidays>
        <Fixed month="JANUARY" day="20" descriptionPropertiesKey="ST_SEBASTIAN"/>
        <Fixed month="APRIL" day="23" validTo="2006" descriptionPropertiesKey="ST_GEORGE"/>
      </Holidays>
    </SubConfigurations>
  </SubConfigurations>

