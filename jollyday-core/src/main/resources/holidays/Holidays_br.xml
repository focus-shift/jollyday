<?xml version="1.0" encoding="UTF-8"?>

<Configuration hierarchy="br" description="Brazil"
               xmlns="https://focus_shift.de/jollyday/schema/holiday"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://focus_shift.de/jollyday/schema/holiday https://focus_shift.de/jollyday/schema/holiday/holiday.xsd">
  <Holidays>
    <Fixed month="JANUARY" day="1" descriptionPropertiesKey="NEW_YEAR"/>
    <Fixed month="APRIL" day="21" descriptionPropertiesKey="TIRADENTES"/>
    <Fixed month="MAY" day="1" descriptionPropertiesKey="LABOUR_DAY"/>
    <Fixed month="SEPTEMBER" day="7" descriptionPropertiesKey="INDEPENDENCE_DAY"/>
    <Fixed month="OCTOBER" day="12" validFrom="1980" descriptionPropertiesKey="APARECIDA"/>
    <Fixed month="NOVEMBER" day="2" descriptionPropertiesKey="ALL_SOULS"/>
    <Fixed month="NOVEMBER" day="15" descriptionPropertiesKey="NATIONAL_DAY"/>
    <Fixed month="NOVEMBER" day="20" validFrom="2024" descriptionPropertiesKey="NATIONAL_DAY_OF_ZUMBI_AND_BLACK_AWARENESS"/>
    <Fixed month="DECEMBER" day="25" descriptionPropertiesKey="CHRISTMAS"/>
    <ChristianHoliday type="EASTER"/>
    <ChristianHoliday type="CARNIVAL"/>
    <ChristianHoliday type="ASH_WEDNESDAY"/>
    <ChristianHoliday type="GOOD_FRIDAY"/>
    <ChristianHoliday type="CORPUS_CHRISTI"/>
  </Holidays>

  <Sources>
    <Source>https://en.wikipedia.org/wiki/Public_holidays_in_Brazil</Source>
    <Source>https://pt.wikipedia.org/wiki/Feriados_no_Brasil</Source>
    <Source>https://propessoas.ufg.br/n/197526-calendario-de-feriados-e-pontos-facultativos-de-2026</Source>
    <Source of="ISO 3166">https://www.iso.org/obp/ui/#iso:code:3166:BR</Source>
    <Source of="ISO 3166-2">https://en.wikipedia.org/wiki/ISO_3166-2:BR</Source>
  </Sources>


  <SubConfigurations hierarchy="rj" description="Rio de Janeiro">
