  </SubConfigurations>

  <SubConfigurations hierarchy="ro" description="Rondônia">
    <Holidays>
      <!-- Lei Estadual (RO) 2.291/2010: creation of the state (Data Magna) -->
      <Fixed month="JANUARY" day="4" descriptionPropertiesKey="FOUNDATION"/>
    </Holidays>
  </SubConfigurations>

  <SubConfigurations hierarchy="rr" description="Roraima">
    <Holidays>
      <!-- Art. 9 of the state constitution: creation of the state (Data Magna) -->
      <Fixed month="OCTOBER" day="5" descriptionPropertiesKey="FOUNDATION"/>
    </Holidays>
  </SubConfigurations>

  <SubConfigurations hierarchy="sc" description="Santa Catarina">
    <Holidays>
      <!-- Lei Estadual (SC) 10.306/1996 as amended by Lei 18.531/2022: observed on the following Sunday unless it falls on a Sunday -->
      <Fixed month="AUGUST" day="11" descriptionPropertiesKey="SANTA_CATARINA_DAY">
        <MovingCondition substitute="MONDAY" with="NEXT" weekday="SUNDAY"/>
        <MovingCondition substitute="TUESDAY" with="NEXT" weekday="SUNDAY"/>
        <MovingCondition substitute="WEDNESDAY" with="NEXT" weekday="SUNDAY"/>
        <MovingCondition substitute="THURSDAY" with="NEXT" weekday="SUNDAY"/>
        <MovingCondition substitute="FRIDAY" with="NEXT" weekday="SUNDAY"/>
        <MovingCondition substitute="SATURDAY" with="NEXT" weekday="SUNDAY"/>
      </Fixed>
    </Holidays>
    <Sources>
      <Source>https://leis.alesc.sc.gov.br/ato-normativo/53811</Source>
    </Sources>
  </SubConfigurations>

  <SubConfigurations hierarchy="se" description="Sergipe">
    <Holidays>
      <!-- Art. 269 of the state constitution: political emancipation of Sergipe (Data Magna) -->
      <Fixed month="JULY" day="8" descriptionPropertiesKey="POLITICAL_EMANCIPATION"/>
    </Holidays>
  </SubConfigurations>

  <SubConfigurations hierarchy="to" description="Tocantins">
    <Holidays>
      <!-- Lei Estadual (TO) 4.509/2024: Our Lord of Bonfim (validFrom=2025) -->
      <Fixed month="AUGUST" day="15" validFrom="2025" descriptionPropertiesKey="LORD_OF_BONFIM"/>
      <!-- Lei Estadual (TO) 627/1993: Our Lady of Natividade, patroness of the state -->
      <Fixed month="SEPTEMBER" day="8" descriptionPropertiesKey="LADY_NATIVIDADE"/>
      <!-- Lei Estadual (TO) 98/1989: creation of the state (Data Magna) -->
      <Fixed month="OCTOBER" day="5" descriptionPropertiesKey="FOUNDATION"/>
    </Holidays>
    <Sources>
      <Source>https://wwa.tjto.jus.br/diario/pesquisa/materia/904337</Source>
    </Sources>
  </SubConfigurations>
</Configuration>
