    <Holidays>
      <Fixed month="SEPTEMBER" day="20" descriptionPropertiesKey="FARROUS_REVOLUTION"/>
    </Holidays>

    <SubConfigurations hierarchy="sm" description="Santa Maria">
      <Holidays>
        <Fixed month="DECEMBER" day="8" descriptionPropertiesKey="LADY_CONCEICAO"/>
